{
    "name": "nosocket/laravel",
    "description": "Laravel adapter for NoSocket.",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "nosocket/nosocket": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "NoSocket\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["NoSocket\\Laravel\\NoSocketServiceProvider"],
            "aliases": {
                "NoSocket": "NoSocket\\Laravel\\Facades\\NoSocket"
            }
        }
    }
}
