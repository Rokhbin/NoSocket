{
    "name": "nosocket/nosocket",
    "description": "Realtime for Shared Hosting.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "NoSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoSocket\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "php tests/php/run.php",
        "test:integration": "php tests/php/integration.php"
    },
    "support": {
        "issues": "https://github.com/nosocket/nosocket/issues"
    }
}
